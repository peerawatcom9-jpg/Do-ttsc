-- ====================== 🌳 ระบบต้นไม้และฟ้าผ่า ======================
local Trees = {}

-- สร้างต้นไม้
local function SpawnTrees()
    for i = 1, 50 do
        local Tree = Instance.new("Part")
        Tree.Name = "Tree_"..i
        Tree.Size = Vector3.new(3, math.random(12, 20), 3)
        Tree.Position = Vector3.new(math.random(-120, 120), Tree.Size.Y/2, math.random(-120, 120))
        Tree.Anchored = true
        Tree.Color = Color3.fromRGB(45, 25, 10)
        Tree.Material = Enum.Material.Wood
        Tree.Parent = Workspace

        local Leaves = Instance.new("Part")
        Leaves.Size = Vector3.new(math.random(6, 10), math.random(5, 8), math.random(6, 10))
        Leaves.Position = Tree.Position + Vector3.new(0, Tree.Size.Y/2 + Leaves.Size.Y/2, 0)
        Leaves.Anchored = true
        Leaves.Color = Color3.fromRGB(20, 80, 20)
        Leaves.Material = Enum.Material.Grass
        Leaves.Parent = Workspace

        table.insert(Trees, {Trunk=Tree, Foliage=Leaves, Warned=false, Struck=false})
    end
end

-- ฟ้าผ่า
local function StrikeLightning(treeData)
    local Tree = treeData.Trunk
    treeData.Struck = true

    -- แสงฟ้าแลบ
    local Light = Instance.new("PointLight")
    Light.Brightness = 15
    Light.Range = 40
    Light.Color = Color3.fromRGB(255, 255, 100)
    Light.Parent = Tree
    game.Lighting.Brightness = 4
    task.wait(0.1)
    game.Lighting.Brightness = 2

    -- ต้นไม้ไหม้
    Tree.Color = Color3.fromRGB(30, 20, 10)
    Tree.Material = Enum.Material.Asphalt

    -- ไฟไหม้
    local Fire = Instance.new("Fire")
    Fire.Size = 8
    Fire.Heat = 6
    Fire.Color = Color3.fromRGB(255, 80, 0)
    Fire.SecondaryColor = Color3.fromRGB(255, 200, 0)
    Fire.Parent = Tree

    task.wait(3)
    Fire:Destroy()
    Light:Destroy()
end

-- แจ้งเตือนก่อนฟ้าผ่า
local function WarnBeforeStrike(treeData)
    if treeData.Warned then return end
    treeData.Warned = true

    local Tree = treeData.Trunk
    local Warning = Instance.new("PointLight")
    Warning.Brightness = 8
    Warning.Range = 20
    Warning.Color = Color3.fromRGB(255, 200, 0)
    Warning.Parent = Tree

    table.insert(LightningWarning, Tree)

    -- แจ้งเตือน
    print("⚠️ ฟ้าจะผ่าต้นไม้ที่: "..tostring(Tree.Position))

    -- ถ้าเปิดเก็บอัตโนมัติ → วิ่งไปเก็บ
    if AutoCollect and LP.Character then
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if Root then
            Root.CFrame = CFrame.new(Tree.Position + Vector3.new(0, 5, 0))
        end
    end

    task.wait(3) -- เวลาเตรียมตัวก่อนโดนผ่า
    Warning:Destroy()
    table.remove(LightningWarning, table.find(LightningWarning, Tree))
    StrikeLightning(treeData)
end

-- สุ่มฟ้าผ่า
task.spawn(function()
    while true do
        task.wait(math.random(8, 15))
        if Enabled.Lightning and #Trees > 0 then
            local RandomTree = Trees[math.random(1, #Trees)]
            if not RandomTree.Struck then
                WarnBeforeStrike(RandomTree)
            end
        end
    end
end)

-- สร้างต้นไม้อัตโนมัติเมื่อเปิด
SpawnTrees()

-- ====================== 🔄 ลูปหลัก ======================
RunService.Heartbeat:Connect(function()
    if not AutoCollect then return end
    local Char = LP.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    -- เก็บต้นไม้ที่กำลังจะโดนผ่า
    for _, Tree in pairs(LightningWarning) do
        if Tree and Tree:IsDescendantOf(Workspace) then
            local Dist = (Root.Position - Tree.Position).Magnitude
            if Dist < 15 then
                -- เก็บได้แล้ว
                Tree:Destroy()
                print("✅ เก็บต้นไม้ก่อนโดนฟ้าผ่า!")
            end
        end
    end
end)

